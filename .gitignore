# Local agent/runtime state
.codeartsdoer/

# 本机 agent 工具链的第三方技能包拷贝（约 2.8MB，非交付物，避免许可证混淆）
# 需要时用 tools/install-codearts-skills.ps1 重新安装
tools/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE and operating system
.idea/
.vscode/
.arts/
.DS_Store
Thumbs.db

# Build and dependency output
node_modules/
dist/
build/
target/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
*.tsbuildinfo
.mvn/wrapper/maven-wrapper.properties.bak
!.mvn/wrapper/maven-wrapper.jar

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and temporary files
*.log
tmp/
temp/
logs/
*.hprof

# Local deployment override
deploy/.env

